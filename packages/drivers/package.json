{
  "name": "@swarm/drivers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/scripted-fake.ts",
      "default": "./dist/scripted-fake.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @swarm/protocol build && pnpm --filter @swarm/runtime-contract build && pnpm build && tsc -p tsconfig.test.json && node --test ./build-test/test/*.test.js"
  },
  "dependencies": {
    "@swarm/protocol": "workspace:*",
    "@swarm/runtime-contract": "workspace:*"
  }
}
